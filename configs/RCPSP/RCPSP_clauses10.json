{
    "hidden_dim": 128,
    "aggr_val2cst": "mean",
    "aggr_cst2val": "mean",
    "aggr_val2var": "mean",
    "sampling": "global",
    "T_train": 25,
    "T_val": 100,
    "epochs": 150,
    "epoch_steps": 1000,
    "lr": 5e-06,
    "lr_decay": 0.1,
    "weight_decay": 0.0,
    "discount": 0.75,
    "reward": "improve",
    "grad_checkpoint": true,
    "batch_size": 1,
    "val_batch_size": 1,
    "partial_weighted": true,
    "train_data": {
        "FILES": {
            "path": "data_paper/rcpsp/train_clauses10/*.wcnf",
            "cache": true
        }
    },
    "val_data": {
        "FILES": {
            "path": "data_paper/rcpsp/val_clauses10/*.wcnf"
        }
    },
    "test_data": {
        "FILES": {
            "path": "data_paper/rcpsp/test/*.wcnf"
        }
    }
}
